# RAG 检索层配置模板 —— 复制为 .env 并按环境填写（.env 已被 gitignore，绝不入库）
# 服务器路径示例：~/codeWorkSpace/tcmtox/tcmtox-llm/rag/.env
# 部署拓扑：RAG 应用与向量索引在开发机（Mac），LLM 由 GPU 服务器 vLLM serve 提供接口，
# Neo4j/Qdrant 为既有服务实例（连接信息仅存本机 .env，不入库）。

# ===== Embedding =====
# api   = newapi 网关 bge-m3（1024 维，与本地 bge-m3 同维度同模型，索引兼容，开发首选）
# local = BGE-m3 本地推理（离线确定性，服务器正式评测用）
EMBEDDING_PROVIDER=api
EMBEDDING_API_MODEL=bge-m3
EMBEDDING_MODEL_PATH=/home/zhl/codeWorkSpace/llms/bge-m3

# ===== Rerank =====
# api = newapi /v1/rerank（bge-reranker-v2-m3）；local = 同模型本地推理；none = 跳过精排
RERANK_PROVIDER=api
RERANK_API_MODEL=bge-reranker-v2-m3
RERANK_MODEL_PATH=/home/zhl/codeWorkSpace/llms/bge-reranker-v2-m3

# ===== newapi 网关 =====
NEWAPI_BASE=https://aiapi.cnkh.com
NEWAPI_KEY=sk-xxxx

# ===== 向量存储（Qdrant 服务版：deploy/docker-compose.yml 已含）=====
RAG_BACKEND=qdrant
QDRANT_HOST=<你的Qdrant服务器IP>
QDRANT_PORT=6333
QDRANT_COLLECTION=tcmtodb
# 备用：Qdrant 服务不可用时填 QDRANT_PATH 并清空 QDRANT_HOST → 切本地文件模式
# QDRANT_PATH=tcmtox-llm/rag/qdrant_local

# ===== Neo4j 图谱（docker compose 已含；图检索代码第二轮接入）=====
NEO4J_URI=bolt://<你的Neo4j服务器IP>:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=请改成你的密码
