# RAG 检索层配置模板 —— 复制为 .env 并按环境填写（.env 已被 gitignore，绝不入库）
# 服务器路径示例：~/codeWorkSpace/tcmtox/tcmtox-llm/rag/.env
# v2 定案：全离线单机方案，embedding/rerank 全部本地推理，零外部运行时依赖

# ===== Embedding =====
# local = BGE-m3 本地推理（FlagEmbedding 加载，1024 维）
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL_PATH=/home/zhl/codeWorkSpace/llms/bge-m3
# 可选增强（当前不用）：api = newapi 网关 qwen3-embedding（4096 维），
# 需同时配置 NEWAPI_BASE/NEWAPI_KEY/EMBEDDING_API_MODEL 并改 EMBEDDING_PROVIDER=api
EMBEDDING_API_MODEL=qwen3-embedding

# ===== Rerank =====
# local = bge-reranker-v2-m3 本地推理（FlagEmbedding.FlagReranker）；none = 跳过精排
RERANK_PROVIDER=local
RERANK_MODEL_PATH=/home/zhl/codeWorkSpace/llms/bge-reranker-v2-m3
# 可选增强（当前不用）：api = newapi /v1/rerank 代理
RERANK_API_MODEL=bge-reranker-v2-m3

# ===== newapi 网关（可选增强，全离线部署不使用）=====
NEWAPI_BASE=https://aiapi.cnkh.com
NEWAPI_KEY=sk-xxxx

# ===== 向量存储 =====
# qdrant = 本地模式（path 持久化，将来一行切服务模式）；numpy = 降级方案
RAG_BACKEND=qdrant
QDRANT_COLLECTION=tcmtodb
