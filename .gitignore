# 数据不入库：原始数据与可再生产物（脚本可一键再生）
tcmtox_data/
tcmtox-llm/data/sft/
tcmtox-llm/data/formula_herbs.csv
# 注意：tcmtox-llm/data/dataset_info.json 是配置，走 git

# Python
__pycache__/
*.pyc
.venv/

# 系统
.DS_Store

# 训练产物（服务器侧生成，绝不入库：checkpoint 超单文件限制且体积巨大）
saves/
*.safetensors
*.bin
*-checkpoint/

# 私人备忘（职业规划等，绝不入库）
private/

# ModelScope 发布工作目录（本地/服务器私有，不入库）
tcmtox-llm/release/

# RAG 密钥配置（API key / 服务地址，绝不入库：仓库已公开）
.env
.env.*
!.env.example
*.env.local

# RAG 派生产物（语料/向量/本地索引——由 build_corpus.py 与灌库脚本再生）
tcmtox-llm/rag/corpus.jsonl
tcmtox-llm/rag/entities.json
tcmtox-llm/rag/qdrant_local/
tcmtox-llm/rag/vectors.npz
